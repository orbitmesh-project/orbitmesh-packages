<?xml version="1.0" encoding="utf-8"?>
<!-- Version is stamped from the .csproj Version property at build time - do not edit here. -->
<Package Name="NetworkTools" Version="0.0.0" Author="Elie Bertret"
         URL="https://blog.forgelab.me"
         Description="Network tools for OrbitMesh (ping, TCP port scanner/check, HTTP check, Wake on LAN, DNS lookup and monitoring)"
         Icon="internet.png"
         ExecutableFilename="OrbitMesh.NetworkTools.dll"
         Runtime="DotNet">
  <Settings>
    <Setting name="Monitoring" type="JsonObject" isRequired="false" ignoreDefaultValue="true" ignoreLocalValue="true" description="The monitored resources">
      <defaultContent>
        [
          { "Name": "Google Public DNS", "Type": "Ping", "Hostname": "8.8.8.8", "Interval": 10 },
          { "Name": "Local OrbitMesh Service", "Type": "Tcp", "Hostname": "localhost", "Port": 8088 },
          { "Name": "Github.com", "Type": "Http", "Address": "https://github.com/myorbitmesh", "Regex": "OrbitMesh", "Interval": 30 }
        ]
      </defaultContent>
    </Setting>
  </Settings>
  <Compatibility dotNetTargetPlatform="net10.0" />
</Package>
